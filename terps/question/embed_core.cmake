# Turn the Quest 5 Core libraries (quest5/aslx-core) into a C++ source file,
# so the interpreter carries them and needs no data files installed next to
# it. Run as: cmake -DCORE_DIR=... -DOUTPUT=... -P embed_core.cmake
file(GLOB CORE_FILES "${CORE_DIR}/*.aslx" "${CORE_DIR}/Languages/*.aslx")
list(SORT CORE_FILES)

set(DATA "")
set(TABLE "")
set(INDEX 0)
foreach(PATH ${CORE_FILES})
    get_filename_component(NAME "${PATH}" NAME)
    file(READ "${PATH}" HEX HEX)
    string(LENGTH "${HEX}" HEXLEN)
    math(EXPR SIZE "${HEXLEN} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" BYTES "${BYTES}")
    string(APPEND DATA "static const unsigned char core_${INDEX}[] = {\n${BYTES}\n};\n\n")
    string(APPEND TABLE "    {\"${NAME}\", core_${INDEX}, ${SIZE}},\n")
    math(EXPR INDEX "${INDEX} + 1")
endforeach()

file(WRITE "${OUTPUT}" "// Generated by embed_core.cmake from quest5/aslx-core. Do not edit.
#include \"aslx.hh\"

#include <cstring>

namespace aslx {

${DATA}static const struct {
    const char *name;
    const unsigned char *data;
    size_t size;
} core_files[] = {
${TABLE}};

bool embedded_core_file(const std::string &name, std::string &out) {
    for (const auto &f : core_files) {
        if (name == f.name) {
            out.assign(reinterpret_cast<const char *>(f.data), f.size);
            return true;
        }
    }
    return false;
}

}  // namespace aslx
")
